---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'sq' } },
    { params: { locale: 'de' } },
    { params: { locale: 'it' } },
  ];
}

const { locale } = Astro.params;

const translations = {
  en: {
    title: 'Contact',
    contactUs: 'Contact us',
    email: 'Email',
    phone: 'Phone',
    hours: 'Hours',
    languages: 'Languages',
    daily: 'Daily',
  },
  sq: {
    title: 'Kontakt',
    contactUs: 'Na kontaktoni',
    email: 'Email',
    phone: 'Telefon',
    hours: 'Orët',
    languages: 'Gjuhët',
    daily: 'Çdo ditë',
  },
  de: {
    title: 'Kontakt',
    contactUs: 'Kontaktieren Sie Uns',
    email: 'E-Mail',
    phone: 'Telefon',
    hours: 'Zeiten',
    languages: 'Sprachen',
    daily: 'Täglich',
  },
  it: {
    title: 'Contatti',
    contactUs: 'Contattaci',
    email: 'Email',
    phone: 'Telefono',
    hours: 'Orari',
    languages: 'Lingue',
    daily: 'Giornaliero',
  },
};

const t = translations[locale as keyof typeof translations] || translations.en;
---

<BaseLayout locale={locale} title={t.title} currentPath={`/${locale}/contact`}>

  <h1>{t.contactUs}</h1>

  <div class="contact-section">
    <div class="contact-item">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <div class="content">
        <p>Rruga Hasan Qosja 53<br/>1000 Tirana<br/>Albania</p>
      </div>
    </div>

    <div class="contact-item">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
      <div class="content">
        <a href="tel:+355692033017">+355 692033017</a>
      </div>
    </div>

    <div class="contact-item">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
      <div class="content">
        <a href="mailto:hello@naveldesign.com">hello@naveldesign.com</a>
      </div>
    </div>

    <div class="contact-item">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <div class="content">
        <p>{t.daily} 09:00 - 17:00</p>
      </div>
    </div>

    <div class="contact-item">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M2 12h20"></path>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
      <div class="content">
        <p>Albanian, German, English, Italian</p>
      </div>
    </div>

    <div class="contact-item social">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
      <div class="content social-links">
        <a href="https://facebook.com/NavelArtDesign" target="_blank" rel="noopener" title="Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href="https://instagram.com/navel.design" target="_blank" rel="noopener" title="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0m0 22.5C6.201 22.5 1.5 17.799 1.5 12S6.201 1.5 12 1.5 22.5 6.201 22.5 12 17.799 22.5 12 22.5m4.5-11.25A4.5 4.5 0 1 1 12 6.75a4.5 4.5 0 0 1 4.5 4.5m1.5 0a6 6 0 1 1-12 0 6 6 0 0 1 12 0m1.125-6.375a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 2rem;
    font-size: 2rem;
  }

  .contact-section {
    max-width: 500px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1rem;
    border-radius: 8px;
    transition: background-color 0.3s;
  }

  .contact-item:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .icon {
    width: 24px;
    height: 24px;
    min-width: 24px;
    color: var(--color-accent);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .content {
    flex: 1;
  }

  .content p {
    margin: 0;
    line-height: 1.6;
    color: var(--color-primary);
  }

  .content a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s;
  }

  .content a:hover {
    color: var(--color-secondary);
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: var(--color-accent);
    color: var(--color-primary);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.3s;
  }

  .social-links a:hover {
    background-color: var(--color-secondary);
    color: var(--color-light);
    transform: translateY(-2px);
  }

  .social-links svg {
    width: 20px;
    height: 20px;
  }
</style>
