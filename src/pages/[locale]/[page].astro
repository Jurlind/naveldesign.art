---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { locale: 'sq', page: 'about' } },
    { params: { locale: 'sq', page: 'contact' } },
    { params: { locale: 'de', page: 'about' } },
    { params: { locale: 'de', page: 'contact' } },
    { params: { locale: 'it', page: 'about' } },
    { params: { locale: 'it', page: 'contact' } },
  ];
}

interface Props {
  params: {
    locale: string;
    page: string;
  };
}

const { locale, page } = Astro.params;

let Content: any;
let title = '';

try {
  const pageData = await import(`../../content/${locale}/${page}.md`);
  Content = pageData.default;
  title = pageData.frontmatter?.title || 'Page';
} catch (e) {
  console.error('Failed to load page:', e);
  return new Response('Page not found', { status: 404 });
}
---

<BaseLayout locale={locale} title={`${title} | Navel Design`} currentPath={`/${locale}/${page}`}>
  <article class="page-content">
    <Content />
  </article>
</BaseLayout>

<style is:global>
  .page-content h1, .page-content h2 {
    color: var(--color-primary);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .page-content p {
    margin-bottom: 1rem;
    line-height: 1.8;
  }

  .page-content ul, .page-content ol {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .page-content li {
    margin-bottom: 0.5rem;
  }

  .page-content a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .page-content a:hover {
    color: var(--color-secondary);
  }
</style>
