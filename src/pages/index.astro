---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSelector from '../components/LanguageSelector.astro';

const locale = 'en';
---

<BaseLayout locale={locale} title="Navel Design - Master Furniture Craftsman" description="Handcrafted wooden furniture by Artan Basha from Tirana, Albania">
  <div class="header-nav">
    <LanguageSelector currentLocale={locale} currentPath="/" />
  </div>

  <div class="hero">
    <h1>Navel Design</h1>
    <p class="subtitle">Master Furniture Craftsman</p>
    <p>Handcrafted wooden furniture by Artan Basha</p>
  </div>

  <section class="featured-work">
    <h2>Featured Work</h2>
    <div class="work-grid">
      <div class="work-item">
        <div class="placeholder-image">Tattoobench</div>
        <h3>Tattoobench</h3>
        <p>Signature piece representing years of craftsmanship and innovation</p>
      </div>
      <div class="work-item">
        <div class="placeholder-image">Walnut Pieces</div>
        <h3>Walnut Collection</h3>
        <p>Premium walnut creations including mirrors and custom pieces</p>
      </div>
      <div class="work-item">
        <div class="placeholder-image">Oak Designs</div>
        <h3>Oak Collection</h3>
        <p>Durable and beautiful pieces crafted from local oak wood</p>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2>Begin Your Project</h2>
    <p>Have a custom furniture idea? Let's bring it to life.</p>
    <a href="/en/contact" class="cta-button">Get in Touch</a>
  </section>
</BaseLayout>

<style>
  .header-nav {
    position: absolute;
    top: 2rem;
    right: 2rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 4rem;
  }

  .hero h1 {
    font-size: 3.5rem;
    letter-spacing: 2px;
  }

  .subtitle {
    font-size: 1.5rem;
    color: var(--color-secondary);
    margin-bottom: 1rem;
  }

  .featured-work {
    margin: 4rem 0;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .work-item {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s;
  }

  .work-item:hover {
    transform: translateY(-4px);
  }

  .placeholder-image {
    width: 100%;
    height: 250px;
    background: linear-gradient(135deg, var(--color-secondary), var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    font-size: 1.1rem;
  }

  .work-item h3 {
    padding: 1rem 1rem 0;
    color: var(--color-primary);
  }

  .work-item p {
    padding: 0.5rem 1rem 1rem;
    color: var(--color-secondary);
  }

  .cta {
    text-align: center;
    margin: 4rem 0;
    padding: 3rem 2rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: var(--color-light);
    border-radius: 8px;
  }

  .cta h2 {
    color: var(--color-accent);
  }

  .cta-button {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 2rem;
    background-color: var(--color-accent);
    color: var(--color-primary);
    border-radius: 4px;
    font-weight: 600;
    transition: background-color 0.3s;
  }

  .cta-button:hover {
    background-color: var(--color-light);
  }
</style>
